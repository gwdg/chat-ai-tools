{
  "name": "crm-mcp",
  "version": "0.1.0",
  "description": "Local-first CRM MCP server backed by SQLite",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "crm",
    "sqlite",
    "contacts"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "crm-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
