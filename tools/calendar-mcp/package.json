{
  "name": "calendar-mcp",
  "version": "0.1.0",
  "description": "Local MCP server for CalDAV calendars with native confirmation for changes",
  "type": "module",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs --http",
    "stdio": "node server.mjs",
    "test": "node --test test/*.test.mjs"
