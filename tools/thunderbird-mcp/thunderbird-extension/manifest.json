{
  "manifest_version": 2,
  "name": "Thunderbird MCP Bridge",
  "version": "0.3.0",
  "description": "Lets thunderbird-mcp mark messages read/answered through Thunderbird's own APIs so flags sync to IMAP.",
  "permissions": ["accountsRead", "messagesRead", "messages.save"],
  "background": {
    "scripts": ["background.js"]
  },
  "experiment_apis": {
    "mcpFlags": {
      "schema": "experiments/flags/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["mcpFlags"]],
        "script": "experiments/flags/implementation.js"
      }
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird-mcp@example.com",
      "strict_min_version": "153.0"
    }
  }
}
