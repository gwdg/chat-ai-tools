{
  "name": "thunderbird-mcp",
  "version": "1.0.0",
  "description": "Local MCP server for reading Thunderbird mail and creating drafts",
  "main": "dist/index.js",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "mcp",
    "thunderbird",
    "email",
    "drafts"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "bin": {
    "thunderbird-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "iconv-lite": "^0.7.0",
    "mailparser": "^3.14.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ]
}
