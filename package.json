{
  "name": "chat-ai-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable tools and examples for Chat AI and SAIA",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "proxy": "node examples/proxy/server.mjs",
    "test": "node --test",
    "mcp:folder": "node tools/local-folder-mcp/server.mjs --http",
    "mcp:folder:http": "node tools/local-folder-mcp/server.mjs --http",
    "mcp:folder:stdio": "node tools/local-folder-mcp/server.mjs",
    "mcp:crm": "node tools/crm-mcp/dist/index.js --http",
    "mcp:crm:http": "node tools/crm-mcp/dist/index.js --http",
    "mcp:crm:stdio": "node tools/crm-mcp/dist/index.js",
    "mcp:browser": "node tools/browser-mcp/server.mjs --http",
    "mcp:browser:http": "node tools/browser-mcp/server.mjs --http",
    "mcp:browser:stdio": "node tools/browser-mcp/server.mjs",
    "mcp:chromium": "node tools/chromium-mcp/relay.mjs --http",
    "mcp:chromium:http": "node tools/chromium-mcp/relay.mjs --http",
    "mcp:chromium:stdio": "node tools/chromium-mcp/relay.mjs",
    "build:windows": "node build/windows/local-folder-mcp/build-sea.mjs",
    "build:browser:windows": "bash build/windows/browser-mcp/build-installer.sh",
    "build:thunderbird:windows": "bash build/windows/thunderbird-mcp/build-installer.sh",
    "build:chromium:windows": "bash build/windows/chromium-mcp/build-installer.sh",
    "build:chromium:extension": "make -C build/linux"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6"
  }
}
